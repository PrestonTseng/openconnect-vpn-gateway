# Copy this file to .env and fill in real values.
# Never commit .env or real credentials.

VPN_HOST=vpn.example.com
VPN_USER=your_username
VPN_PASS=your_password_or_password_plus_mfa_token

# Strongly recommended. Example:
# VPN_SERVERCERT=pin-sha256:PGgRrjWLPK5VaqVGfdfkC1H5JFxGDodP24lM0MT+wSc=
VPN_SERVERCERT=

# Optional site-specific settings.
# VPN_AUTHGROUP=
# VPN_PROTOCOL=anyconnect
# VPN_RECONNECT_TIMEOUT=60
# OPENCONNECT_EXTRA_ARGS=--non-inter

# DNS behavior. Default keeps Docker DNS (127.0.0.11) so Compose service names keep resolving
# after VPN connect, while preserving VPN-provided search domains. Set to 0 to use stock
# vpnc-script DNS handling if your site requires VPN DNS to replace container DNS.
# VPN_PRESERVE_DOCKER_DNS=1

# Optional stronger health check against a private-network endpoint.
# VPN_HEALTHCHECK_URL=https://intranet.example.com/health
# VPN_HEALTHCHECK_TIMEOUT=5
# VPN_TUN_IFACE=tun0

# Secret-file alternative:
# VPN_PASS_FILE=/run/secrets/vpn_pass
# VPN_SERVERCERT_FILE=/run/secrets/vpn_servercert
